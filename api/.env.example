APP_NAME=Account-gold
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONTEND_URL=http://localhost:4200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=account_gold
DB_USERNAME=account_gold
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# First Super Admin created by `php artisan db:seed`. Replace the password at once with
# `php artisan auth:reset-password admin@accountgold.local` (it never uses "Forgot password").
ADMIN_EMAIL=admin@accountgold.local
ADMIN_PASSWORD=ChangeMe123

# Password reset (docs/specs/password-reset.md R11): Super Admin reset by email stays off until 2FA (AG-005).
AUTH_SUPER_ADMIN_EMAIL_RESET=false

# Backups (AG-093, docs/specs/backups.md; see README "Backups"). Production refuses to back up without a password.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_ARCHIVE_OLD_PASSWORDS=
BACKUP_TIME=01:30
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql
# Alerts also go here when the Super Admins cannot be read (database down). Comma separated.
BACKUP_ALERT_EMAILS=
# Cache store for the backup locks and schedule mutexes. Not `database`; use redis with more than one app server.
BACKUP_LOCK_STORE=file
# BACKUP_VERIFY_DB_DATABASE=account_gold_verify  (MySQL scratch database for backup:verify; SQLite uses a temp file)
# Off-server copy: set BACKUP_OFFSITE_DISK=backups_offsite and its own S3 key (Put, Get, List only).
BACKUP_OFFSITE_DISK=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
